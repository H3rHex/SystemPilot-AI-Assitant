      "updated": 1785848299705,
      "link": null,
      "locked": false,
      "text": "This node is responsible only for\nrunning the selected tools, in order to\npass the context to the next node.\n\n(Add tool resoult)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This node is responsible only for running the selected tools, in order to pass the context to the next node.\n\n(Add tool resoult)",
