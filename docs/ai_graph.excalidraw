      "isDeleted": false,
      "boundElements": [],
      "updated": 1785848299705,
      "link": null,
      "locked": false,
      "text": "This module is responsible for passing\nthe user's action and the available\ntools to the AI model so that it can\ndecide which tools to use.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This module is responsible for passing the user's action and the available tools to the AI model so that it can decide which tools to use.",
      "autoResize": false,
      "lineHeight": 1.25
    },
